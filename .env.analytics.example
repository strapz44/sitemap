# Analytics Configuration
# ========================

# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/analytics
# ou alternative
DATABASE_URL=postgresql://user:password@localhost:5432/analytics

# CORS Settings
CORS_ORIGINS=https://example.com,https://app.example.com,http://localhost:3000
CORS_CREDENTIALS=true
CORS_ALLOW_ALL=false

# Analytics Real-time Settings
ANALYTICS_REFRESH_INTERVAL=300000      # 5 minutes
ANALYTICS_CACHE_EXPIRY=60000           # 1 minute
ANALYTICS_DEFAULT_LIMIT=10             # Default limit for API results

# Analysis Jobs Configuration
ANALYSIS_TIMEOUT=600000                # 10 minutes
ANALYSIS_SIMULATION_DELAY=3000         # For dev: simulate 3s processing
ANALYSIS_MAX_CONCURRENT=3              # Max concurrent jobs
ANALYSIS_HISTORY_LIMIT=100             # Keep last 100 jobs
ANALYSIS_RETENTION_DAYS=30             # Delete jobs older than 30 days

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000                # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100            # Max 100 requests per window

# Logging
LOG_LEVEL=debug                        # debug, info, warn, error
LOG_FORMAT=json                        # json, text

# API Configuration
VUE_APP_API_URL=http://localhost:3000  # Frontend API URL
API_TIMEOUT=30000                      # 30 seconds

# Feature Flags
FEATURE_REAL_TIME=true                 # Enable real-time updates
FEATURE_ANALYSIS_JOBS=true             # Enable analysis jobs
FEATURE_HISTORICAL_DATA=true           # Enable historical data
FEATURE_EXPORT_DATA=false              # Enable data export
FEATURE_COMPARISONS=false              # Enable comparisons

# Environment
NODE_ENV=development                   # development, production
