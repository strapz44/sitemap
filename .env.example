# ╔══════════════════════════════════════════════════════════════╗
# ║  Prerender V3 — Environment Variables                      ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development

# ── Authentication (REQUIRED in production) ───────────────────
JWT_SECRET=                         # Min 32 chars, cryptographically random. REQUIRED in production.
MONGODB_URI=                        # MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/dbname)

# ── Database — PostgreSQL (analytics) ─────────────────────────
POSTGRES_URL=                       # PostgreSQL connection string
DATABASE_URL=                       # Alternative to POSTGRES_URL
DB_POOL_SIZE=5                      # Connection pool size
DB_IDLE_TIMEOUT=10000               # Idle timeout (ms)
DB_SSL=true                         # Enable SSL for PostgreSQL

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=                       # Comma-separated allowed origins (e.g. https://app.prerender.io)
CORS_ALLOW_ALL=false                # Allow all origins (development only!)

# ── Analytics ─────────────────────────────────────────────────
ANALYTICS_REFRESH_INTERVAL=300000   # Analytics refresh interval (ms, default: 5min)
ANALYTICS_CACHE_EXPIRY=60000        # Cache expiry (ms, default: 1min)
ANON_SALT=                          # Salt for anonymous visitor ID hashing

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000             # Window duration (ms)
RATE_LIMIT_MAX_REQUESTS=100         # Max requests per window

# ── Application ───────────────────────────────────────────────
APP_URL=https://v-prerender.vercel.app
VUE_APP_API_URL=                    # laisser vide (Vercel proxie /api/* automatiquement)

# ── Email — Resend (https://resend.com — free: 3000 emails/month) ──
RESEND_API_KEY=                     # re_xxxxxxxxxxxxxxxx — REQUIRED for forgot-password emails
MAIL_FROM=Prerender <noreply@v-prerender.vercel.app>

# ── Google OAuth (https://console.cloud.google.com) ───────────
# URI de redirection autorisée à ajouter dans Google Cloud Console :
#   https://v-prerender.vercel.app/api/auth/google
GOOGLE_CLIENT_ID=                   # xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=               # GOCSPX-xxxxxxxxxxxxxxxxxxxxxx

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_REAL_TIME=true
FEATURE_ANALYSIS_JOBS=true
FEATURE_HISTORICAL_DATA=true
FEATURE_EXPORT_DATA=false
FEATURE_COMPARISONS=false
