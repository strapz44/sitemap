{
  "name": "prerender-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix v-prerender run serve",
    "dev:backend": "npm --prefix ms-prerender run dev",
    "build": "npm --prefix v-prerender run build && npm --prefix ms-prerender run build",
    "start:backend": "npm --prefix ms-prerender run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
