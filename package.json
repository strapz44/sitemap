{
  "name": "prerender-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:manager\"",
    "dev:frontend": "npm --prefix v-prerender run serve",
    "dev:backend": "npm --prefix ms-prerender run dev",
    "dev:manager": "npm --prefix ms-prerender-manager run dev",
    "build": "npm --prefix v-prerender run build && npm --prefix ms-prerender run build",
    "vercel-build": "npm --prefix v-prerender install && npm --prefix v-prerender run build",
    "start:backend": "npm --prefix ms-prerender run start",
    "test:analytics": "node api/analytics/__tests__.js",
    "deploy:analytics": "bash deploy-analytics.sh production",
    "deploy:analytics:netlify": "bash deploy-analytics.sh netlify",
    "deploy:analytics:vercel": "bash deploy-analytics.sh vercel"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.11.5"
  }
}
