{
    "version":  2,
    "buildCommand":  "npm run build",
    "outputDirectory":  "dist",
    "cleanUrls":  true,
    "rewrites":  [
                     {
                         "destination":  "/api/:match*",
                         "source":  "/api/:match*"
                     }
                 ],
    "routes":  [
                   {
                       "handle":  "filesystem"
                   },
                   {
                       "src":  "/.*",
                       "dest":  "/index.html"
                   }
               ]
}
