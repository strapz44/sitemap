<template>
  <div class="app-wrapper">
    <div class="page-container">
      <h1 class="main-title">SITEMAPS</h1>
      
      <div class="sitemap-section">
        <h2 class="section-title">AJOUTER UN SITEMAP</h2>
        <div class="input-group">
          <input
            placeholder="entre ton site...."
            class="input"
            name="text"
            type="text"
            v-model="url"
          />
          <button class="btn-add" @click="addSitemap">
            Ajouter
          </button>
        </div>
      </div>

      <div class="sitemap-list">
        <h2 class="section-title">LISTE DES SITEMAPS</h2>
        <div class="table">
          <div class="table-header">
            <div class="header-cell">NOM DU SITE</div>
            <div class="header-cell">PAGES</div>
            <div class="header-cell">ACTIONS</div>
          </div>
          
          <div v-for="(item, idx) in filteredSitemaps" :key="idx" class="table-row">
            <div class="table-cell">{{ item.siteName }}</div>
            <div class="table-cell">{{ item.sitemap.urlset.url.length }}</div>
            <div class="table-cell actions">
              <button class="action-btn" @click="openSiteSummary(item)">
                Voir
              </button>
              <button class="action-btn" @click="refreshSitemap(item.siteName)">
                Recharger
              </button>
              <button class="delete-btn" @click="deleteSitemap(item.siteName)">
                <svg viewBox="0 0 448 512" class="svgIcon">
                  <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue'

const url = ref('')
const sitemaps = ref([])
const search = ref('')

const addSitemap = () => {
  if (!url.value.trim()) return
  const newSitemap = {
    siteName: url.value,
    sitemap: {
      urlset: {
        url: [
          {
            loc: `https://${url.value}/page1`,
            priority: '0.8',
            lastmod: '2025-06-30',
            changefreq: 'weekly'
          },
          {
            loc: `https://${url.value}/page2`,
            priority: '0.5',
            lastmod: '2025-06-28',
            changefreq: 'monthly'
          }
        ]
      }
    }
  }
  sitemaps.value.push(newSitemap)
  url.value = ''
}

const filteredSitemaps = computed(() => {
  if (!search.value.trim()) return sitemaps.value
  return sitemaps.value.filter(item =>
    item.siteName.toLowerCase().includes(search.value.toLowerCase())
  )
})

const deleteSitemap = (siteName) => {
  if (!confirm(`Supprimer le sitemap pour ${siteName} ?`)) return
  sitemaps.value = sitemaps.value.filter(item => item.siteName !== siteName)
}

const refreshSitemap = (siteName) => {
  console.log(`Rechargement du sitemap pour : ${siteName}`)
}

const openSiteSummary = (item) => {
  const urls = item.sitemap.urlset.url
  console.log('Détails du sitemap pour:', item.siteName)
  console.log('Liste des URLs:')
  urls.forEach((url, index) => {
    console.log(`${index + 1}. ${url.loc}`)
    console.log(`   Priority: ${url.priority}`)
    console.log(`   Last Modified: ${url.lastmod}`)
    console.log(`   Change Frequency: ${url.changefreq}`)
    console.log('---')
  })
}
</script>

